# ========================================
# MOONSHOT BOT - Environment Configuration
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)

# ========================================
# BINANCE API CREDENTIALS (REQUIRED)
# ========================================
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
# Required permissions: Futures trading, Reading
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Set to 'true' for testnet, 'false' for live trading
BINANCE_TESTNET=false

# ========================================
# REDIS DATABASE (REQUIRED)
# ========================================
# For local development: redis://localhost:6379
# For production (Railway, etc): Get from your Redis provider
REDIS_URL=redis://localhost:6379

# ========================================
# TRADING PARAMETERS
# ========================================
# Initial account equity (USD)
INITIAL_EQUITY=30.0

# Leverage (5x recommended for safety)
DEFAULT_LEVERAGE=5
MAX_LEVERAGE=10

# Minimum margin per position (USD)
# With 5x leverage: $2 margin = $10 notional (Binance min)
MIN_MARGIN_USD=2.00

# Maximum margin per trade (% of equity)
MAX_MARGIN_PERCENT=15.0

# Maximum concurrent positions
MAX_CONCURRENT_TRADES=34

# ========================================
# DASHBOARD SERVER
# ========================================
# Port for web dashboard
PORT=8050

# ========================================
# LOGGING
# ========================================
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Timezone for logs
BOT_TIMEZONE=UTC

# ========================================
# OPTIONAL: Advanced Settings
# ========================================
# Macro direction change cooldown (seconds)
# DIRECTION_CHANGE_COOLDOWN_SECONDS=3600
